# --- Storage ---
# SQLite database, thumbnail cache and exports live under this directory.
DATA_DIR=./data

# --- Path remapping ---
# Manifest JSON paths are absolute server paths (e.g. /group-volume/...). When the
# dashboard runs somewhere the volume is mounted elsewhere, replace the prefix.
# Set both to the same value (or leave empty) to use paths as-is.
PATH_PREFIX_FROM=/group-volume
PATH_PREFIX_TO=/group-volume

# Root directory that sample `image` fields are relative to.
IMAGE_ROOT=/group-volume/lit/data/sr-llava/finetune/image_folder

# Where HuggingFace imports write their LLaVA JSON. Images go to IMAGE_ROOT/hf_imports/<name>/.
OUTPUT_ROOT=/group-volume/lit/data/sr-llava/finetune/json/hf_imports

# --- HuggingFace ---
# Used by the Python worker and the `hf` CLI for private/gated datasets. Never sent to the browser.
HF_TOKEN=

# --- Python worker ---
# Python interpreter with the workers/ dependencies installed (see workers/README.md).
PYTHON_BIN=./workers/.venv/bin/python

# --- Background watching ---
# Optional: an Excel manifest on the server to watch; browsers are told when it changes.
MANIFEST_PATH=
# How often (ms) to compare indexed JSON files' mtimes; stale variants are flagged (default 5 min).
STALE_CHECK_MS=300000
# "true" re-indexes stale variants automatically instead of only flagging them.
AUTO_REINDEX=false
