    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
